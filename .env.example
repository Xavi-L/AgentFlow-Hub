# Copy to .env.local, fill in local values, then export it as shown in README.md.
# Spring Boot does not automatically load this file. Do not commit .env.local.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# Mandatory stable local path; all JVMs using the same database must share this file.
# Choose an absolute path outside temporary directories, e.g. /var/lib/agentflow/task.lock.
AGENTFLOW_TASK_RECOVERY_LOCK_PATH=
# Enable CONTROLLED_SINGLE_HOST only after documented cold cutover of every old JVM.
AGENTFLOW_TASK_RECOVERY_MODE=DISABLED
# V0.2-B: actual local LLM/RAG/tool work; abandoned calls retain permits until exit.
AGENTFLOW_TASK_MAX_CONCURRENT_EXTERNAL_CALLS=4

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=agentflow_hub
POSTGRES_USER=agentflow
# Set the password chosen when creating the local PostgreSQL role.
POSTGRES_PASSWORD=

# Generate a private value with: openssl rand -base64 32
JWT_SECRET_BASE64=
JWT_ACCESS_TOKEN_TTL=PT2H

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0

# Use an OpenAI-compatible Chat endpoint and its exact model identifier.
# These defaults target a separately started local model server.
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=qwen/qwen3-1.7b
OPENAI_TIMEOUT=PT30S

# Agent advanced settings inherit these defaults unless the Agent overrides them.
# maxTokens is the total task budget; these are per-call output limits.
AGENTFLOW_TASK_DECISION_MAX_OUTPUT_TOKENS=512
AGENTFLOW_TASK_FINAL_MAX_OUTPUT_TOKENS=
AGENTFLOW_TASK_DECISION_JSON_SCHEMA_ENABLED=false
AGENTFLOW_TASK_DECISION_JSON_OBJECT_ENABLED=false
AGENTFLOW_TASK_PROVIDER_THINKING_DISABLED=false
AGENTFLOW_AGENT_MAX_OUTPUT_TOKENS=16384
AGENTFLOW_AGENT_MAX_MODEL_CALL_TIMEOUT_SECONDS=600
# Comma-separated exact model IDs; leave empty until verified for this deployment.
AGENTFLOW_AGENT_JSON_OBJECT_MODELS=
AGENTFLOW_AGENT_JSON_SCHEMA_MODELS=
AGENTFLOW_AGENT_THINKING_DISABLED_MODELS=

# Real embedding/vector adapters; API keys remain empty until configured locally.
KNOWLEDGE_VECTORIZATION_MODE=remote
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIMENSIONS=1024
DASHSCOPE_TIMEOUT=PT30S
QDRANT_BASE_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=agentflow_chunks_te_v4_1024
QDRANT_VECTOR_SIZE=1024
QDRANT_TIMEOUT=PT10S

# Optional: AGENTFLOW_DOCUMENT_STORAGE_ROOT defaults to ~/.agentflow-hub/documents.
# Provider-specific decision options and the accepted GLM-5.2 settings are documented
# in frontend/e2e/README.md; enable them only for a compatible configured provider.
