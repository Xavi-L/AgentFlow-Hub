    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.code === "OK", "Expected code OK");
    client.assert(response.body.data.submitted === true, "Expected submitted status");
    client.assert(response.body.data.feedback.feedbackId === client.global.get("agentflowChatAnswerFeedbackId"),
      "Expected the same V12 feedbackId");
    client.assert(response.body.data.feedback.answerId === client.global.get("agentflowChatAnswerId"),
      "Expected the same immutable answerId");
    client.assert(response.body.data.feedback.verdict === "HELPFUL", "Expected original V12 verdict");
    client.assert(response.body.data.feedback.createdAt === client.global.get("agentflowChatAnswerFeedbackCreatedAt"),
      "Expected original V12 creation time");
  });
%}

