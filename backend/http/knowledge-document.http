# Knowledge-document ingestion checks for IntelliJ IDEA HTTP Client.
#
# 1. Run "Login" in user-auth.http to create the local agentflowAccessToken variable.
# 2. Run "Create a knowledge base" in knowledge-base.http. Its successful response now
#    stores agentflowKnowledgeBaseId in the same local HTTP-client session.
# 3. Run the upload/process/vectorize/list requests below. Do not paste a real token or
#    absolute file path into this tracked file.

@baseUrl = http://localhost:8080

### Upload the tracked Markdown fixture: expected HTTP 201, code OK, and PENDING.
POST {{baseUrl}}/api/v1/knowledge-bases/{{agentflowKnowledgeBaseId}}/documents
Authorization: Bearer {{agentflowAccessToken}}
Content-Type: multipart/form-data; boundary=AgentFlowDocumentBoundary
X-Trace-Id: af-manual-document-upload-001

--AgentFlowDocumentBoundary
Content-Disposition: form-data; name="file"; filename="refund-rules.md"
Content-Type: text/markdown

< ./fixtures/refund-rules.md
--AgentFlowDocumentBoundary--

> {%
  client.test("document is accepted as pending", function () {
    client.assert(response.status === 201, "Expected HTTP 201");
    client.assert(response.body.code === "OK", "Expected code OK");
    client.assert(response.body.data.fileType === "MD", "Expected MD file type");
    client.assert(response.body.data.parseStatus === "PENDING", "Expected PENDING status");
  });
  // The ID is kept only in IDEA's local HTTP-client session for V4 chunk verification.
  client.global.set("agentflowDocumentId", response.body.data.id);
%}

### Process every currently PENDING document in this knowledge base: expected HTTP 200.
POST {{baseUrl}}/api/v1/knowledge-bases/{{agentflowKnowledgeBaseId}}/documents/process-pending
Authorization: Bearer {{agentflowAccessToken}}
X-Trace-Id: af-manual-document-process-001

> {%
  client.test("pending documents are processed", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.code === "OK", "Expected code OK");
    client.assert(response.body.data.claimed >= response.body.data.completed,
      "Completed count must not exceed claimed count");
    client.assert(response.body.data.claimed === response.body.data.completed + response.body.data.failed,
      "Each claimed document must complete or fail");
  });
%}

### List the current user's documents after V4 processing: expected HTTP 200.
GET {{baseUrl}}/api/v1/knowledge-bases/{{agentflowKnowledgeBaseId}}/documents?page=1&pageSize=20
Authorization: Bearer {{agentflowAccessToken}}
X-Trace-Id: af-manual-document-list-after-process-001

> {%
  client.test("documents are paged", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.code === "OK", "Expected code OK");
    client.assert(Array.isArray(response.body.data.items), "Expected items array");
  });
%}

### Vectorize the current knowledge base's PENDING chunks: expected HTTP 200.
# V6 remote mode requires a running local Qdrant and DASHSCOPE_API_KEY in the same
# AgentFlow process environment. It writes a real text-embedding-v4 dense vector to
# Qdrant, so this request consumes the provider's input-token quota.
POST {{baseUrl}}/api/v1/knowledge-bases/{{agentflowKnowledgeBaseId}}/chunks/vectorize-pending
Authorization: Bearer {{agentflowAccessToken}}
X-Trace-Id: af-manual-chunk-vectorize-001

> {%
  client.test("pending chunks are vectorized", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.code === "OK", "Expected code OK");
    client.assert(response.body.data.claimed === response.body.data.completed + response.body.data.failed,
      "Each claimed chunk must complete or fail");
    client.assert(response.body.data.completed >= 1,
      "Expected at least one successfully vectorized fixture chunk");
  });
%}

### Repeat the V5 request: expected HTTP 200 with completed=0 and previously completed chunks skipped.
POST {{baseUrl}}/api/v1/knowledge-bases/{{agentflowKnowledgeBaseId}}/chunks/vectorize-pending
Authorization: Bearer {{agentflowAccessToken}}
X-Trace-Id: af-manual-chunk-vectorize-repeat-001

> {%
  client.test("completed chunks are safely skipped on repeat", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.data.completed === 0, "Expected no second vectorization");
    client.assert(response.body.data.skipped >= 1, "Expected the completed fixture chunk to be skipped");
  });
%}

### Inspect the uploaded document's persisted chunks: expected HTTP 200 and V5 vector status/ID.
GET {{baseUrl}}/api/v1/knowledge-bases/{{agentflowKnowledgeBaseId}}/documents/{{agentflowDocumentId}}/chunks?page=1&pageSize=20
Authorization: Bearer {{agentflowAccessToken}}
X-Trace-Id: af-manual-document-chunks-after-vectorize-001

> {%
  client.test("chunks are visible for the current owner", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.code === "OK", "Expected code OK");
    client.assert(Array.isArray(response.body.data.items), "Expected chunk items array");
    client.assert(response.body.data.items.length >= 1, "Expected at least one chunk");
    client.assert(response.body.data.items[0].chunkIndex === 0, "Expected zero-based chunk index");
    client.assert(response.body.data.items[0].vectorizationStatus === "COMPLETED",
      "Expected V5 vectorization to complete");
    client.assert(typeof response.body.data.items[0].vectorId === "string"
      && /^[0-9a-f]{8}-[0-9a-f]{4}-8[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/.test(response.body.data.items[0].vectorId),
      "Expected a stable UUID vectorId");
    client.assert(typeof response.body.data.items[0].contentHash === "string"
      && /^[0-9a-f]{64}$/.test(response.body.data.items[0].contentHash),
      "Expected a SHA-256 contentHash");
  });
%}

### V7 semantic retrieval verification: expected HTTP 200 with canonical chunks only.
# This embeds the query through the same configured DashScope model and queries the V6
# Qdrant collection, so it also consumes provider input-token quota. It is deliberately
# not an answer-generation, rerank, or Agent endpoint.
POST {{baseUrl}}/api/v1/knowledge-bases/{{agentflowKnowledgeBaseId}}/retrieve-test
Authorization: Bearer {{agentflowAccessToken}}
Content-Type: application/json
X-Trace-Id: af-manual-retrieve-test-001

{
  "query": "退款失败时应该如何排查？",
  "topK": 5
}

> {%
  client.test("semantic retrieval returns scoped canonical chunks", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.code === "OK", "Expected code OK");
    client.assert(response.body.data.query === "退款失败时应该如何排查？", "Expected normalized query");
    client.assert(response.body.data.topK === 5, "Expected requested topK");
    client.assert(Array.isArray(response.body.data.items), "Expected result items array");
    client.assert(response.body.data.items.length >= 1, "Expected at least one fixture chunk");
    client.assert(response.body.data.items[0].rank === 1, "Expected first result rank");
    client.assert(typeof response.body.data.items[0].score === "number", "Expected vector score");
    client.assert(typeof response.body.data.items[0].chunkId === "string", "Expected canonical chunkId");
    client.assert(typeof response.body.data.items[0].content === "string", "Expected canonical chunk content");
  });
%}

### Invalid V7 topK: expected HTTP 400 / COMMON_PARAM_INVALID.
POST {{baseUrl}}/api/v1/knowledge-bases/{{agentflowKnowledgeBaseId}}/retrieve-test
Authorization: Bearer {{agentflowAccessToken}}
Content-Type: application/json
X-Trace-Id: af-manual-retrieve-test-invalid-topk-001

{
  "query": "退款失败如何处理？",
  "topK": 11
}

### V8 deterministic RAG context assembly: expected HTTP 200 with [S#] markers and sources.
# This reuses V7 retrieval, so it still embeds the query and queries the configured V6 Qdrant
# collection. It does not call an LLM, build a prompt, or generate an answer.
POST {{baseUrl}}/api/v1/knowledge-bases/{{agentflowKnowledgeBaseId}}/retrieve-context-test
Authorization: Bearer {{agentflowAccessToken}}
Content-Type: application/json
X-Trace-Id: af-manual-retrieve-context-test-001

{
  "query": "退款失败时应该如何排查？",
  "topK": 5,
  "maxContextTokens": 3000
}

> {%
  client.test("V8 context uses stable source markers within its budget", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.code === "OK", "Expected code OK");
    client.assert(response.body.data.maxContextTokens === 3000, "Expected requested context budget");
    client.assert(response.body.data.usedContextTokens <= response.body.data.maxContextTokens,
      "Assembled context must stay within its budget");
    client.assert(typeof response.body.data.skippedChunkCount === "number",
      "Expected an explicit skipped chunk count");
    client.assert(typeof response.body.data.context === "string", "Expected assembled context string");
    client.assert(Array.isArray(response.body.data.sources), "Expected included source array");
    client.assert(response.body.data.sources.length >= 1, "Expected at least one fixture source");
    client.assert(response.body.data.sources[0].citationId === "S1", "Expected stable first citation ID");
    client.assert(typeof response.body.data.sources[0].chunkId === "string", "Expected canonical chunkId");
    client.assert(typeof response.body.data.sources[0].documentId === "string", "Expected canonical documentId");
    client.assert(typeof response.body.data.sources[0].fileName === "string", "Expected source filename");
    client.assert(typeof response.body.data.sources[0].titlePath === "string", "Expected source title path");
    client.assert(typeof response.body.data.sources[0].score === "number", "Expected retrieval score");
    client.assert(response.body.data.context.indexOf("[S1]") >= 0, "Expected [S1] in context");
  });
%}

### V8 no-truncation boundary: expected HTTP 200, empty context, and skipped chunks.
POST {{baseUrl}}/api/v1/knowledge-bases/{{agentflowKnowledgeBaseId}}/retrieve-context-test
Authorization: Bearer {{agentflowAccessToken}}
Content-Type: application/json
X-Trace-Id: af-manual-retrieve-context-test-budget-001

{
  "query": "退款失败时应该如何排查？",
  "topK": 5,
  "maxContextTokens": 1
}

> {%
  client.test("V8 does not truncate a chunk to fit", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.data.context === "", "Expected no partial context");
    client.assert(response.body.data.sources.length === 0, "Expected no partial source");
    client.assert(response.body.data.skippedChunkCount >= 1, "Expected oversized chunks to be counted");
  });
%}

### Invalid V8 maxContextTokens: expected HTTP 400 / COMMON_PARAM_INVALID.
POST {{baseUrl}}/api/v1/knowledge-bases/{{agentflowKnowledgeBaseId}}/retrieve-context-test
Authorization: Bearer {{agentflowAccessToken}}
Content-Type: application/json
X-Trace-Id: af-manual-retrieve-context-test-invalid-budget-001

{
  "query": "退款失败如何处理？",
  "topK": 5,
  "maxContextTokens": 0
}

### V9 one-shot grounded chat: run only when a local OpenAI-compatible server is configured.
# Set OPENAI_BASE_URL, OPENAI_API_KEY (or leave it empty only for a local no-auth server), and
# OPENAI_CHAT_MODEL in the AgentFlow process environment. This makes one real model call and is
# intentionally not an automated acceptance check. V9 itself reuses V8 context/sources; it does
# not rerank, rebuild context, or create a session/history.
POST {{baseUrl}}/api/v1/knowledge-bases/{{agentflowKnowledgeBaseId}}/chat-test
Authorization: Bearer {{agentflowAccessToken}}
Content-Type: application/json
X-Trace-Id: af-manual-chat-test-001

{
  "query": "退款失败时应该如何排查？",
  "topK": 5,
  "maxContextTokens": 3000,
  "maxAnswerTokens": 512
}

> {%
  client.test("V9 answer is grounded in the V8 source table", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.code === "OK", "Expected code OK");
    client.assert(typeof response.body.data.answer === "string" && response.body.data.answer.length > 0,
      "Expected a non-empty answer");
    client.assert(response.body.data.maxContextTokens === 3000, "Expected V8 context budget");
    client.assert(response.body.data.usedContextTokens <= response.body.data.maxContextTokens,
      "V8 context accounting must be preserved");
    client.assert(response.body.data.maxAnswerTokens === 512, "Expected configured answer budget");
    client.assert(Array.isArray(response.body.data.sources) && response.body.data.sources.length >= 1,
      "Expected original V8 source table");
    client.assert(Array.isArray(response.body.data.citationIds) && response.body.data.citationIds.length >= 1,
      "Expected server-validated citations");
    response.body.data.citationIds.forEach(function (citationId) {
      client.assert(response.body.data.sources.some(function (source) {
        return source.citationId === citationId;
      }), "Every citation must map to a returned V8 source");
    });
  });
%}

### V10 one-shot grounded chat with immutable answer audit: run only after V9's prerequisites are ready.
# This makes one real model call through the existing V9 path, then freezes only the validated
# answer, V8 budgets, valid citation IDs, and V8 source table. It does not create a session or
# a retrieval log. Run the following GET immediately after this request; it must not call a model.
POST {{baseUrl}}/api/v1/knowledge-bases/{{agentflowKnowledgeBaseId}}/chat
Authorization: Bearer {{agentflowAccessToken}}
Content-Type: application/json
X-Trace-Id: af-manual-v10-chat-audit-001

{
  "query": "退款失败时应该如何排查？",
  "topK": 5,
  "maxContextTokens": 3000,
  "maxAnswerTokens": 512
}

> {%
  client.test("V10 saves one citation-validated answer snapshot", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.code === "OK", "Expected code OK");
    client.assert(typeof response.body.data.answerId === "string" && response.body.data.answerId.length > 0,
      "Expected persisted answerId");
    client.assert(typeof response.body.data.answer === "string" && response.body.data.answer.length > 0,
      "Expected a non-empty answer");
    client.assert(response.body.data.maxContextTokens === 3000, "Expected frozen V8 context budget");
    client.assert(response.body.data.usedContextTokens <= response.body.data.maxContextTokens,
      "Expected preserved V8 context accounting");
    client.assert(Array.isArray(response.body.data.sources) && response.body.data.sources.length >= 1,
      "Expected frozen V8 source table");
    client.assert(Array.isArray(response.body.data.citationIds) && response.body.data.citationIds.length >= 1,
      "Expected V9-validated citations");
    response.body.data.citationIds.forEach(function (citationId) {
      client.assert(response.body.data.sources.some(function (source) {
        return source.citationId === citationId;
      }), "Every citation must map to the frozen V8 source table");
    });
  });
  client.global.set("agentflowChatAnswerId", response.body.data.answerId);
%}

### V10 read the immutable answer snapshot: expected HTTP 200 without a new retrieval or model call.
GET {{baseUrl}}/api/v1/knowledge-bases/{{agentflowKnowledgeBaseId}}/chat-answers/{{agentflowChatAnswerId}}
Authorization: Bearer {{agentflowAccessToken}}
X-Trace-Id: af-manual-v10-chat-audit-read-001

> {%
  client.test("V10 reads the saved answer and sources", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.code === "OK", "Expected code OK");
    client.assert(response.body.data.answerId === client.global.get("agentflowChatAnswerId"),
      "Expected the same immutable answerId");
    client.assert(typeof response.body.data.answer === "string" && response.body.data.answer.length > 0,
      "Expected the saved answer");
    client.assert(typeof response.body.data.createdAt === "string", "Expected snapshot creation time");
    client.assert(Array.isArray(response.body.data.sources) && response.body.data.sources.length >= 1,
      "Expected saved source snapshot");
    client.assert(Array.isArray(response.body.data.citationIds) && response.body.data.citationIds.length >= 1,
      "Expected saved valid citation IDs");
  });
%}

### V11 page the immutable answer-audit ledger: expected HTTP 200 without retrieval or a model call.
# Run this after the V10 POST above has saved agentflowChatAnswerId. This reads only the V10
# knowledge_chat_answer row summaries for the current owner and this knowledge base; it does
# not create a chat, session, context, source table, or provider request.
GET {{baseUrl}}/api/v1/knowledge-bases/{{agentflowKnowledgeBaseId}}/chat-answers?page=1&pageSize=20
Authorization: Bearer {{agentflowAccessToken}}
X-Trace-Id: af-manual-v11-chat-audit-list-001

> {%
  client.test("V11 returns only immutable answer-audit summaries", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.code === "OK", "Expected code OK");
    client.assert(response.body.data.page === 1, "Expected requested page");
    client.assert(response.body.data.pageSize === 20, "Expected requested page size");
    client.assert(Array.isArray(response.body.data.items), "Expected paged audit-summary items");
    client.assert(response.body.data.items.length >= 1, "Expected the V10 audit saved above");
    const item = response.body.data.items[0];
    client.assert(typeof item.answerId === "string" && item.answerId.length > 0,
      "Expected immutable answerId");
    client.assert(typeof item.query === "string" && item.query.length > 0,
      "Expected frozen query summary");
    client.assert(Array.isArray(item.citationIds) && item.citationIds.length >= 1,
      "Expected frozen validated citation IDs");
    client.assert(typeof item.createdAt === "string", "Expected audit creation time");
    client.assert(!Object.prototype.hasOwnProperty.call(item, "answer"),
      "V11 list must not expose full answer text");
    client.assert(!Object.prototype.hasOwnProperty.call(item, "sources"),
      "V11 list must not expose the V10 source snapshot");
    client.assert(!Object.prototype.hasOwnProperty.call(item, "maxContextTokens"),
      "V11 list must not expose V8 budget fields");
  });
%}

### V12 submit one immutable binary answer-feedback event: expected HTTP 200 without retrieval or a model call.
# Run this after the V10 POST above has set agentflowChatAnswerId. V12 scopes every feedback
# lookup/write through this V10 answer's current owner and knowledge base, then appends exactly
# one independent feedback row. It does not mutate the V10 answer, create a session, or call V7/V8/V9/a model.
POST {{baseUrl}}/api/v1/knowledge-bases/{{agentflowKnowledgeBaseId}}/chat-answers/{{agentflowChatAnswerId}}/feedback
Authorization: Bearer {{agentflowAccessToken}}
Content-Type: application/json
X-Trace-Id: af-manual-v12-answer-feedback-create-001

{
  "verdict": "HELPFUL"
}

> {%
  client.test("V12 records one immutable HELPFUL feedback event", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.code === "OK", "Expected code OK");
    client.assert(response.body.message === "Knowledge chat answer feedback recorded",
      "Expected recorded-feedback message");
    client.assert(typeof response.body.data.feedbackId === "string" && response.body.data.feedbackId.length > 0,
      "Expected immutable feedbackId");
    client.assert(response.body.data.answerId === client.global.get("agentflowChatAnswerId"),
      "Expected feedback for the V10 answer saved above");
    client.assert(response.body.data.verdict === "HELPFUL", "Expected submitted verdict");
    client.assert(typeof response.body.data.createdAt === "string", "Expected immutable feedback creation time");
  });
  client.global.set("agentflowChatAnswerFeedbackId", response.body.data.feedbackId);
  client.global.set("agentflowChatAnswerFeedbackCreatedAt", response.body.data.createdAt);
%}

### V12 retry the same verdict: expected HTTP 200 with the existing event and no second write.
POST {{baseUrl}}/api/v1/knowledge-bases/{{agentflowKnowledgeBaseId}}/chat-answers/{{agentflowChatAnswerId}}/feedback
Authorization: Bearer {{agentflowAccessToken}}
Content-Type: application/json
X-Trace-Id: af-manual-v12-answer-feedback-idempotent-retry-001

{
  "verdict": "HELPFUL"
}

> {%
  client.test("V12 same-verdict retry returns the original immutable event", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.code === "OK", "Expected code OK");
    client.assert(response.body.data.feedbackId === client.global.get("agentflowChatAnswerFeedbackId"),
      "Expected the original feedbackId rather than a duplicate row");
    client.assert(response.body.data.answerId === client.global.get("agentflowChatAnswerId"),
      "Expected feedback for the same answer");
    client.assert(response.body.data.verdict === "HELPFUL", "Expected original verdict");
    client.assert(response.body.data.createdAt === client.global.get("agentflowChatAnswerFeedbackCreatedAt"),
      "Expected original immutable creation time");
  });
%}

### V12 reject an opposite verdict: expected HTTP 409 / KNOWLEDGE_CHAT_ANSWER_FEEDBACK_CONFLICT.
# This is not an update operation: the existing HELPFUL event remains unchanged.
POST {{baseUrl}}/api/v1/knowledge-bases/{{agentflowKnowledgeBaseId}}/chat-answers/{{agentflowChatAnswerId}}/feedback
Authorization: Bearer {{agentflowAccessToken}}
Content-Type: application/json
X-Trace-Id: af-manual-v12-answer-feedback-conflict-001

{
  "verdict": "NOT_HELPFUL"
}

> {%
  client.test("V12 refuses an opposite immutable verdict", function () {
    client.assert(response.status === 409, "Expected HTTP 409");
    client.assert(response.body.code === "KNOWLEDGE_CHAT_ANSWER_FEEDBACK_CONFLICT",
      "Expected controlled immutable-feedback conflict");
  });
%}

### V12 reject extra request fields: expected HTTP 400 / COMMON_REQUEST_BODY_INVALID.
# Only one textual verdict field is permitted; comments and client-controlled identifiers are outside V12.
POST {{baseUrl}}/api/v1/knowledge-bases/{{agentflowKnowledgeBaseId}}/chat-answers/{{agentflowChatAnswerId}}/feedback
Authorization: Bearer {{agentflowAccessToken}}
Content-Type: application/json
X-Trace-Id: af-manual-v12-answer-feedback-extra-field-001

{
  "verdict": "HELPFUL",
  "comment": "This field is intentionally unsupported"
}

> {%
  client.test("V12 accepts no free-text comment field", function () {
    client.assert(response.status === 400, "Expected HTTP 400");
    client.assert(response.body.code === "COMMON_REQUEST_BODY_INVALID",
      "Expected strict one-field request-body validation");
  });
%}

### V9 empty V8 context: expected HTTP 409 / KNOWLEDGE_CONTEXT_EMPTY and no LLM call.
# This request is safe to run even with no local model service: the V8 one-token budget cannot
# contain a whole fixture block, so KnowledgeChatService returns before it reaches ChatGateway.
POST {{baseUrl}}/api/v1/knowledge-bases/{{agentflowKnowledgeBaseId}}/chat-test
Authorization: Bearer {{agentflowAccessToken}}
Content-Type: application/json
X-Trace-Id: af-manual-chat-test-empty-context-001

{
  "query": "退款失败时应该如何排查？",
  "topK": 5,
  "maxContextTokens": 1,
  "maxAnswerTokens": 256
}

> {%
  client.test("V9 refuses an answer without V8 sources", function () {
    client.assert(response.status === 409, "Expected HTTP 409");
    client.assert(response.body.code === "KNOWLEDGE_CONTEXT_EMPTY",
      "Expected controlled empty-context error");
  });
%}

