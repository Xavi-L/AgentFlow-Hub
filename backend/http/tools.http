### V28 valid query with no match: expected 200 OK, empty logs and SUCCESS.
POST {{baseUrl}}/api/v1/tools/{{paymentLogQueryToolId}}/test
Authorization: Bearer {{agentflowAccessToken}}
Content-Type: application/json
X-Trace-Id: af-manual-payment-log-empty-001

{
  "arguments": {
    "errorCode": "E_PAY_UNKNOWN"
  }
}

> {%
  client.test("a valid no-match payment query is a successful empty result", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.code === "OK", "Expected code OK");
    client.assert(response.body.data.success === true, "Expected SUCCESS result");
    client.assert(Array.isArray(response.body.data.data.logs), "Expected logs array");
    client.assert(response.body.data.data.logs.length === 0, "Expected empty logs");
  });
%}

