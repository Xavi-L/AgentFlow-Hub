# V27/V28 ToolRuntime manual checks for IntelliJ IDEA HTTP Client.
#
# First run "Login" from user-auth.http. It stores the short-lived token only in
# IDEA's local HTTP-client session as agentflowAccessToken. These requests use the
# deterministic order_query/payment_log_query definitions inserted by Flyway V13/V14.
#
# This file is prepared acceptance input, not evidence that the requests have run.

@baseUrl = http://localhost:8080
@orderQueryToolId = 270000000000000001
@paymentLogQueryToolId = 280000000000000001

### V28 list the two visible built-in tools without exposing config.handler or audit fields.
GET {{baseUrl}}/api/v1/tools
Authorization: Bearer {{agentflowAccessToken}}
X-Trace-Id: af-manual-tool-list-001

> {%
  client.test("the two safe active built-in definitions are returned", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.code === "OK", "Expected code OK");
    client.assert(Array.isArray(response.body.data), "Expected a tool array");
    client.assert(response.body.data.length === 2, "Expected the V13 and V14 tool fixtures");
    var orderTool = response.body.data.find(function (item) {
      return item.toolCode === "order_query";
    });
    var paymentTool = response.body.data.find(function (item) {
      return item.toolCode === "payment_log_query";
    });
    client.assert(String(orderTool.id) === "270000000000000001", "Expected fixed order tool ID");
    client.assert(String(paymentTool.id) === "280000000000000001", "Expected fixed payment tool ID");
    client.assert(orderTool.type === "BUILTIN" && paymentTool.type === "BUILTIN",
      "Expected BUILTIN types");
    client.assert(orderTool.permissionLevel === "MEDIUM" && paymentTool.permissionLevel === "MEDIUM",
      "Expected MEDIUM permissions");
    client.assert(orderTool.timeoutMs === 3000, "Expected order timeout configuration");
    client.assert(paymentTool.timeoutMs === 5000, "Expected payment timeout configuration");
    response.body.data.forEach(function (tool) {
      client.assert(tool.retryCount === 0, "Expected zero retries");
      client.assert(tool.requiresConfirmation === false, "Expected no confirmation");
      client.assert(tool.status === "ACTIVE", "Expected ACTIVE status");
      client.assert(tool.config === undefined, "Internal config must not be returned");
      client.assert(tool.handler === undefined, "Internal handler must not be returned");
      client.assert(tool.createdAt === undefined, "Audit time must not be returned");
      client.assert(tool.updatedAt === undefined, "Audit time must not be returned");
      client.assert(tool.deletedAt === undefined, "Soft-delete time must not be returned");
    });
  });
%}

### V27 successful order_query through ToolRuntime: expected the six safe V26 order fields.
POST {{baseUrl}}/api/v1/tools/{{orderQueryToolId}}/test
Authorization: Bearer {{agentflowAccessToken}}
Content-Type: application/json
X-Trace-Id: af-manual-order-query-success-001

{
  "arguments": {
    "orderNo": "order_1024"
  }
}

> {%
  client.test("order_query returns the PostgreSQL-backed V26 order", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.code === "OK", "Expected code OK");
    client.assert(response.body.data.success === true, "Expected successful tool result");
    client.assert(response.body.data.toolCode === "order_query", "Expected order_query result");
    var order = response.body.data.data;
    client.assert(order.orderNo === "order_1024", "Expected fixture order");
    client.assert(Number(order.amount) === 199, "Expected amount 199.00");
    client.assert(order.currency === "CNY", "Expected CNY");
    client.assert(order.status === "CREATED", "Expected CREATED order status");
    client.assert(order.paymentStatus === "PAY_FAILED", "Expected PAY_FAILED");
    client.assert(order.errorCode === "E_PAY_TIMEOUT", "Expected timeout error");
    client.assert(Object.keys(order).sort().join(",")
      === "amount,currency,errorCode,orderNo,paymentStatus,status",
      "Tool data must expose exactly the six V26 fields");
  });
%}

### V28 payment_log_query by orderNo: expected one PostgreSQL-backed safe log and SUCCESS.
POST {{baseUrl}}/api/v1/tools/{{paymentLogQueryToolId}}/test
Authorization: Bearer {{agentflowAccessToken}}
Content-Type: application/json
X-Trace-Id: af-manual-payment-log-by-order-001

{
  "arguments": {
    "orderNo": "order_1024"
  }
}

> {%
  client.test("payment_log_query returns only the six safe V26 payment fields", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.code === "OK", "Expected code OK");
    client.assert(response.body.data.success === true, "Expected successful tool result");
    client.assert(response.body.data.toolCode === "payment_log_query", "Expected payment tool result");
    var logs = response.body.data.data.logs;
    client.assert(Array.isArray(logs) && logs.length === 1, "Expected the fixed payment log");
    var log = logs[0];
    client.assert(log.orderNo === "order_1024", "Expected order number");
    client.assert(log.traceId === "pay-trace-1024", "Expected payment trace");
    client.assert(log.level === "ERROR", "Expected ERROR level");
    client.assert(log.errorCode === "E_PAY_TIMEOUT", "Expected timeout code");
    client.assert(log.message === "Payment gateway response timeout after 3000ms", "Expected fixed message");
    client.assert(log.occurredAt === "2026-05-01T12:00:00+08:00", "Expected business event time");
    client.assert(Object.keys(log).sort().join(",")
      === "errorCode,level,message,occurredAt,orderNo,traceId",
      "Tool data must expose exactly the six V26 fields");
  });
%}

