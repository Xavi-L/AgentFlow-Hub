### Whitespace-only description becomes null.
POST {{baseUrl}}/api/v1/agents
Authorization: Bearer {{agentflowAccessToken}}
Content-Type: application/json
X-Trace-Id: af-manual-agent-blank-description-001

{
  "name": "空描述 Agent",
  "description": "   ",
  "systemPrompt": "验证描述归一化。",
  "modelProvider": "openai-compatible",
  "modelName": "kimi-k2"
}

> {%
  client.test("blank description is normalized to null", function () {
    client.assert(response.status === 201, "Expected HTTP 201");
    client.assert(
      response.body.data.description === null || response.body.data.description === undefined,
      "Expected no non-null description"
    );
  });
%}

### List current owner's non-deleted Agents: summaries must omit the prompt and budgets.
GET {{baseUrl}}/api/v1/agents?page=1&pageSize=20
Authorization: Bearer {{agentflowAccessToken}}
X-Trace-Id: af-manual-agent-list-001

> {%
  client.test("current owner receives compact paged Agent summaries", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.code === "OK", "Expected code OK");
    client.assert(Array.isArray(response.body.data.items), "Expected items array");
    var createdId = client.global.get("agentflowAgentId");
    var created = response.body.data.items.find(function (item) {
      return item.id === createdId;
    });
    client.assert(created !== undefined, "Expected the current user's created Agent");
    client.assert(created.systemPrompt === undefined, "List must omit systemPrompt");
    client.assert(created.temperature === undefined, "List must omit temperature");
    client.assert(created.topP === undefined, "List must omit topP");
    client.assert(created.maxSteps === undefined, "List must omit execution budgets");
    client.assert(created.userId === undefined, "List must omit owner ID");
    client.assert(created.config === undefined, "List must omit internal config");
    client.assert(created.deletedAt === undefined, "List must omit deletion marker");
  });
%}

