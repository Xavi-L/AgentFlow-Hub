### V34 flow setup: create a dedicated Agent for bodyless status actions.
POST {{baseUrl}}/api/v1/agents
Authorization: Bearer {{agentflowAccessToken}}
Content-Type: application/json
X-Trace-Id: af-manual-agent-status-create-001

{
  "name": "V34 启停 Agent",
  "description": "验证启停、幂等、既有管理路径和删除边界。",
  "systemPrompt": "只用于 V34 启停验收。",
  "modelProvider": "openai-compatible",
  "modelName": "kimi-k2",
  "temperature": 0.4,
  "topP": 0.9,
  "maxSteps": 8,
  "maxToolCalls": 5,
  "maxTokens": 9000,
  "timeoutSeconds": 180
}

> {%
  client.test("V34 flow creates one ACTIVE current-owner Agent", function () {
    client.assert(response.status === 201, "Expected HTTP 201");
    client.assert(response.body.code === "OK", "Expected code OK");
    client.assert(response.body.data.status === "ACTIVE", "Expected initial ACTIVE status");
    client.global.set("agentflowStatusAgentId", response.body.data.id);
    client.global.set("agentflowStatusCreatedAt", response.body.data.createdAt);
    client.global.set("agentflowStatusUpdatedAt", response.body.data.updatedAt);
  });
%}

### V34 disable: no request body, full public DTO, DISABLED, and refreshed updatedAt.
POST {{baseUrl}}/api/v1/agents/{{agentflowStatusAgentId}}/disable
Authorization: Bearer {{agentflowAccessToken}}
X-Trace-Id: af-manual-agent-disable-001

> {%
  client.test("current owner disables one live Agent", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.code === "OK", "Expected code OK");
    client.assert(response.body.message === "Agent disabled", "Expected disable message");
    var agent = response.body.data;
    client.assert(agent.id === client.global.get("agentflowStatusAgentId"), "Expected same Agent ID");
    client.assert(agent.name === "V34 启停 Agent", "Expected preserved name");
    client.assert(agent.description === "验证启停、幂等、既有管理路径和删除边界。", "Expected preserved description");
    client.assert(agent.systemPrompt === "只用于 V34 启停验收。", "Expected preserved prompt");
    client.assert(agent.modelProvider === "openai-compatible" && agent.modelName === "kimi-k2", "Expected preserved model");
    client.assert(agent.temperature === 0.4 && agent.topP === 0.9, "Expected preserved sampling config");
    client.assert(agent.maxSteps === 8 && agent.maxToolCalls === 5, "Expected preserved execution budgets");
    client.assert(agent.maxTokens === 9000 && agent.timeoutSeconds === 180, "Expected preserved token/time budgets");
    client.assert(agent.status === "DISABLED", "Expected DISABLED status");
    client.assert(agent.createdAt === client.global.get("agentflowStatusCreatedAt"), "createdAt must not change");
    client.assert(agent.updatedAt !== client.global.get("agentflowStatusUpdatedAt"), "Real transition must refresh updatedAt");
    client.assert(agent.userId === undefined, "Owner ID must not be returned");
    client.assert(agent.config === undefined, "Internal config must not be returned");
    client.assert(agent.deletedAt === undefined, "Deletion marker must not be returned");
    client.global.set("agentflowStatusUpdatedAt", agent.updatedAt);
  });
%}

