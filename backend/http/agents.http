### Authentication remains required: expected 401 / AUTH_UNAUTHENTICATED.
GET {{baseUrl}}/api/v1/agents?page=1&pageSize=20
X-Trace-Id: af-manual-agent-no-auth-001

### V31 detail authentication remains required: expected 401 / AUTH_UNAUTHENTICATED.
GET {{baseUrl}}/api/v1/agents/{{agentflowExplicitAgentId}}
X-Trace-Id: af-manual-agent-detail-no-auth-001

> {%
  client.test("Agent detail requires authentication", function () {
    client.assert(response.status === 401, "Expected HTTP 401");
    client.assert(response.body.code === "AUTH_UNAUTHENTICATED", "Expected AUTH_UNAUTHENTICATED");
  });
%}
