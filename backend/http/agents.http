### V33 flow setup: create a dedicated Agent that will be patched and soft-deleted.
POST {{baseUrl}}/api/v1/agents
Authorization: Bearer {{agentflowAccessToken}}
Content-Type: application/json
X-Trace-Id: af-manual-agent-delete-create-001

{
  "name": "V33 待删除 Agent",
  "description": "验证软删除前后的公开可见性。",
  "systemPrompt": "只用于 V33 软删除验收。",
  "modelProvider": "openai-compatible",
  "modelName": "kimi-k2"
}

> {%
  client.test("V33 flow creates one current-owner Agent", function () {
    client.assert(response.status === 201, "Expected HTTP 201");
    client.assert(response.body.code === "OK", "Expected code OK");
    client.global.set("agentflowDeleteAgentId", response.body.data.id);
  });
%}

### V33 flow PATCH: prove the existing update path sees the live row before deletion.
PATCH {{baseUrl}}/api/v1/agents/{{agentflowDeleteAgentId}}
Authorization: Bearer {{agentflowAccessToken}}
Content-Type: application/json
X-Trace-Id: af-manual-agent-delete-patch-before-001

{
  "name": "V33 即将软删除 Agent"
}

> {%
  client.test("V33 flow patches the live Agent before deletion", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.message === "Agent updated", "Expected update message");
    client.assert(response.body.data.name === "V33 即将软删除 Agent", "Expected updated name");
  });
%}

### V33 soft delete: request has no body and keeps the shared HTTP 200 envelope.
DELETE {{baseUrl}}/api/v1/agents/{{agentflowDeleteAgentId}}
Authorization: Bearer {{agentflowAccessToken}}
X-Trace-Id: af-manual-agent-delete-001

> {%
  client.test("current owner soft-deletes one live Agent", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.code === "OK", "Expected code OK");
    client.assert(response.body.message === "Agent deleted", "Expected delete message");
    client.assert(response.body.data === null, "Expected data null");
  });
%}

### V33 detail after deletion: existing V31 visibility must return the uniform 404.
GET {{baseUrl}}/api/v1/agents/{{agentflowDeleteAgentId}}
Authorization: Bearer {{agentflowAccessToken}}
X-Trace-Id: af-manual-agent-delete-detail-after-001

> {%
  client.test("soft-deleted Agent is hidden from detail", function () {
    client.assert(response.status === 404, "Expected HTTP 404");
    client.assert(response.body.code === "COMMON_NOT_FOUND", "Expected COMMON_NOT_FOUND");
    client.assert(response.body.message === "Agent not found", "Expected uniform not-found message");
  });
%}

### V33 PATCH after deletion: existing V32 live-row lock must not revive the row.
PATCH {{baseUrl}}/api/v1/agents/{{agentflowDeleteAgentId}}
Authorization: Bearer {{agentflowAccessToken}}
Content-Type: application/json
X-Trace-Id: af-manual-agent-delete-patch-after-001

{
  "name": "不得复活"
}

> {%
  client.test("soft-deleted Agent cannot be patched or revived", function () {
    client.assert(response.status === 404, "Expected HTTP 404");
    client.assert(response.body.code === "COMMON_NOT_FOUND", "Expected COMMON_NOT_FOUND");
    client.assert(response.body.message === "Agent not found", "Expected uniform not-found message");
  });
%}

### V33 list after deletion: existing V30 page must omit the soft-deleted Agent.
GET {{baseUrl}}/api/v1/agents?page=1&pageSize=100
Authorization: Bearer {{agentflowAccessToken}}
X-Trace-Id: af-manual-agent-delete-list-after-001

> {%
  client.test("soft-deleted Agent is hidden from the current-owner list", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    var deletedId = client.global.get("agentflowDeleteAgentId");
    var stillVisible = response.body.data.items.some(function (item) {
      return item.id === deletedId;
    });
    client.assert(!stillVisible, "Deleted Agent must not remain in the list");
  });
%}

