GET {{baseUrl}}/api/v1/agents/{{agentflowExplicitAgentId}}
Authorization: Bearer {{agentflowAccessToken}}
X-Trace-Id: af-manual-agent-update-readback-001

> {%
  client.test("V31 detail reads back the V32 effective configuration", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    var agent = response.body.data;
    client.assert(agent.name === "支付问题诊断助手 V2", "Expected updated name");
    client.assert(agent.temperature === 0.3, "Expected updated temperature");
    client.assert(agent.maxSteps === 8 && agent.maxToolCalls === 5, "Expected updated budgets");
    client.assert(agent.systemPrompt === "只分析输入中已有的支付事实。", "Expected preserved prompt");
    client.assert(agent.status === "ACTIVE", "Expected preserved status");
  });
%}

### V32 merged budget violation: stored maxToolCalls is 5, so maxSteps 4 is invalid.
PATCH {{baseUrl}}/api/v1/agents/{{agentflowExplicitAgentId}}
Authorization: Bearer {{agentflowAccessToken}}
Content-Type: application/json
X-Trace-Id: af-manual-agent-update-cross-field-001

{
  "maxSteps": 4
}

> {%
  client.test("single-field budget PATCH validates against the stored counterpart", function () {
    client.assert(response.status === 400, "Expected HTTP 400");
    client.assert(response.body.code === "COMMON_PARAM_INVALID", "Expected COMMON_PARAM_INVALID");
  });
%}

