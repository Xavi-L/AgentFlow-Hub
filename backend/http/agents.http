# V30/V31 Agent root-resource manual checks for IntelliJ IDEA HTTP Client.
#
# First register/login a disposable test user through user-auth.http. The token stays in
# IDEA's local session as agentflowAccessToken; never paste a real token into this file.
#
# This file is prepared acceptance input, not evidence that the requests have run.

@baseUrl = http://localhost:8080

### Create with only required fields: expected HTTP 201 and frozen V30 defaults.
POST {{baseUrl}}/api/v1/agents
Authorization: Bearer {{agentflowAccessToken}}
Content-Type: application/json
X-Trace-Id: af-manual-agent-defaults-001

{
  "name": "支付问题诊断助手",
  "systemPrompt": "你是企业内部研发运营助手，负责分析支付问题。",
  "modelProvider": "openai-compatible",
  "modelName": "kimi-k2"
}

> {%
  client.test("current user creates an ACTIVE Agent with frozen defaults", function () {
    client.assert(response.status === 201, "Expected HTTP 201");
    client.assert(response.body.code === "OK", "Expected code OK");
    var agent = response.body.data;
    client.assert(typeof agent.id === "string", "BIGINT ID must be a string");
    client.assert(agent.temperature === 0.2, "Expected temperature 0.2");
    client.assert(agent.topP === 0.8, "Expected topP 0.8");
    client.assert(agent.maxSteps === 6, "Expected maxSteps 6");
    client.assert(agent.maxToolCalls === 4, "Expected maxToolCalls 4");
    client.assert(agent.maxTokens === 8000, "Expected maxTokens 8000");
    client.assert(agent.timeoutSeconds === 120, "Expected timeoutSeconds 120");
    client.assert(agent.status === "ACTIVE", "Expected ACTIVE status");
    client.assert(agent.userId === undefined, "Owner ID must not be returned");
    client.assert(agent.config === undefined, "Internal config must not be returned");
    client.assert(agent.currentPromptVersionId === undefined, "Prompt version is outside V30");
    client.assert(agent.deletedAt === undefined, "Deletion marker must not be returned");
    client.global.set("agentflowAgentId", agent.id);
  });
%}

### Create explicit bounded configuration: expected exact public configuration in HTTP 201.
POST {{baseUrl}}/api/v1/agents
Authorization: Bearer {{agentflowAccessToken}}
Content-Type: application/json
X-Trace-Id: af-manual-agent-explicit-001

{
  "name": "支付问题诊断助手（显式配置）",
  "description": "用于验证 V30 公开配置。",
  "systemPrompt": "只分析输入中已有的支付事实。",
  "modelProvider": "openai-compatible",
  "modelName": "qwen3",
  "temperature": 0,
  "topP": 1,
  "maxSteps": 20,
  "maxToolCalls": 20,
  "maxTokens": 100000,
  "timeoutSeconds": 600
}

> {%
  client.test("explicit Agent configuration is returned without internal fields", function () {
    client.assert(response.status === 201, "Expected HTTP 201");
    var agent = response.body.data;
    client.assert(agent.temperature === 0, "Expected lower temperature boundary");
    client.assert(agent.topP === 1, "Expected upper topP boundary");
    client.assert(agent.maxSteps === 20 && agent.maxToolCalls === 20, "Expected equal step/tool bounds");
    client.assert(agent.maxTokens === 100000, "Expected max token boundary");
    client.assert(agent.timeoutSeconds === 600, "Expected timeout boundary");
    client.global.set("agentflowExplicitAgentId", agent.id);
  });
%}

### V31 detail: read back the exact complete public configuration created above.
GET {{baseUrl}}/api/v1/agents/{{agentflowExplicitAgentId}}
Authorization: Bearer {{agentflowAccessToken}}
X-Trace-Id: af-manual-agent-detail-001

> {%
  client.test("current owner reads one complete safe Agent configuration", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.code === "OK", "Expected code OK");
    client.assert(response.body.message === "Agent retrieved", "Expected detail message");
    var agent = response.body.data;
    client.assert(typeof agent.id === "string", "BIGINT ID must remain a string");
    client.assert(agent.id === client.global.get("agentflowExplicitAgentId"), "Expected created Agent ID");
    client.assert(agent.name === "支付问题诊断助手（显式配置）", "Expected full name");
    client.assert(agent.description === "用于验证 V30 公开配置。", "Expected description");
    client.assert(agent.systemPrompt === "只分析输入中已有的支付事实。", "Expected full prompt");
    client.assert(agent.modelProvider === "openai-compatible", "Expected provider");
    client.assert(agent.modelName === "qwen3", "Expected model");
    client.assert(agent.temperature === 0, "Expected temperature");
    client.assert(agent.topP === 1, "Expected topP");
    client.assert(agent.maxSteps === 20, "Expected maxSteps");
    client.assert(agent.maxToolCalls === 20, "Expected maxToolCalls");
    client.assert(agent.maxTokens === 100000, "Expected maxTokens");
    client.assert(agent.timeoutSeconds === 600, "Expected timeoutSeconds");
    client.assert(agent.status === "ACTIVE", "Expected ACTIVE status");
    client.assert(agent.createdAt !== undefined, "Expected createdAt");
    client.assert(agent.updatedAt !== undefined, "Expected updatedAt");
    client.assert(agent.userId === undefined, "Owner ID must not be returned");
    client.assert(agent.config === undefined, "Internal config must not be returned");
    client.assert(agent.deletedAt === undefined, "Deletion marker must not be returned");
    client.assert(agent.currentPromptVersionId === undefined, "Prompt version remains outside V31");
    client.assert(agent.knowledgeBaseIds === undefined, "Knowledge bindings remain outside V31");
    client.assert(agent.toolIds === undefined, "Tool bindings remain outside V31");
  });
%}

### V31 well-formed but invisible ID: expected 404 / COMMON_NOT_FOUND / Agent not found.
GET {{baseUrl}}/api/v1/agents/9223372036854775807
Authorization: Bearer {{agentflowAccessToken}}
X-Trace-Id: af-manual-agent-detail-missing-001

> {%
  client.test("scoped detail miss uses the uniform not-found contract", function () {
    client.assert(response.status === 404, "Expected HTTP 404");
    client.assert(response.body.code === "COMMON_NOT_FOUND", "Expected COMMON_NOT_FOUND");
    client.assert(response.body.message === "Agent not found", "Expected uniform Agent not found message");
  });
%}

