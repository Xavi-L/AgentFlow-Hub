### V26 Demo Business API still requires login: expected HTTP 401.
GET {{baseUrl}}/api/v1/demo/orders/order_1024
X-Trace-Id: af-manual-demo-order-no-token-001

> {%
  client.test("demo business data is not public", function () {
    client.assert(response.status === 401, "Expected HTTP 401");
    client.assert(response.body.code === "AUTH_UNAUTHENTICATED", "Expected AUTH_UNAUTHENTICATED");
  });
%}
