  "cards": [
    {
      "dot": "cyan",
      "title": "先确认旧 JVM 已退出",
      "items": [
        "cold-cutover 对指定Java PID发SIGTERM；退出或zombie才记录并exec，超时/观测失败拒绝。",
        "单主机、同一数据库执行域、稳定本地绝对锁路径；操作者清点全部旧执行器，非跨主机fencing。"
      ]
    },
    {
      "dot": "violet",
      "title": "只收尾持久事实",
      "items": [
        "受控模式按id分页，每项行锁、校验、step/tool收尾、终态与事件原子提交；失败只回滚本项。",
        "QUEUED记未启动，RUNNING结果未知；取消优先，usage仅汇总已记录事实，不重发模型/工具。"
      ]
    },
    {
      "dot": "rose",
      "title": "进程锁与准入分开",
      "items": [
        "DISABLED也持锁；有遗留就关闭，无遗留可开放。受控模式为CONTROLLED_SINGLE_HOST。",
        "Context关闭准入但不释放锁；JVM退出才释放。恢复失败保留诊断，不在本进程自动重扫。"
      ]
    }
  ]
