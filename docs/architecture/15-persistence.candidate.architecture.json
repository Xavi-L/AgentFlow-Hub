  "cards": [
    {
      "dot": "violet",
      "title": "引用关系与冻结边界",
      "items": [
        "实线指向被引用身份；虚线为应用层定位、派生或留存，无跨存储事务。",
        "版本禁止 UPDATE；Task 状态可变，创建时内嵌快照。历史配置身份可空。"
      ]
    },
    {
      "dot": "cyan",
      "title": "正文、向量与历史事实",
      "items": [
        "PG chunk 是正文事实；Qdrant 以 owner / 文档代次等筛选，命中再回查。",
        "重处理推进代次；Trace 保存引用与正文快照，不对历史命中加当前源 FK。"
      ]
    },
    {
      "dot": "orange",
      "title": "持久化不等于执行证明",
      "items": [
        "绑定归属 Agent；知识库须同 owner，工具目录全局，条目有唯一约束。",
        "Evaluation / Episode 是本地证据文件，无专用 DB 表；缺评仍未评。"
      ]
    }
  ]
