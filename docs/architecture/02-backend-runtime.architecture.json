  "cards": [
    {
      "dot": "emerald",
      "title": "执行与事务边界",
      "items": [
        "创建 / 快照解析在短事务；commit 后才派发。",
        "Runner 负责终态收尾；Engine 返回执行结果。"
      ]
    },
    {
      "dot": "cyan",
      "title": "存储与观察职责",
      "items": [
        "各领域有自身 Mapper；图中 DB 边是代表性连接。",
        "SSE 入口直接回读持久事件，不调用 Runner。"
      ]
    },
    {
      "dot": "amber",
      "title": "外部工作边界",
      "items": [
        "受限调用：外派工作并等待；慢 I/O 在长事务之外。",
        "网关 / JDBC 跨网络，依赖见图 01；本轮未做真实服务验收。"
      ]
    }
  ]
