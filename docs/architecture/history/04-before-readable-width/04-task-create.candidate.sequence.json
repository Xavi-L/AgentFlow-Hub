  "cards": [
    {
      "dot": "cyan",
      "title": "幂等 / 配置分支",
      "items": [
        "同 owner/key + 同 fingerprint：200 复用，不再创建或派发；不同则冲突。",
        "configVersionId 显式取版本；省略则捕获当前草稿。随后解析实际快照并校验 ACTIVE / READY / 工具。"
      ]
    },
    {
      "dot": "amber",
      "title": "回滚 / 拒绝边界",
      "items": [
        "创建回滚不派发；并发写冲突在事务退出后独立回读 winner。",
        "派发拒绝：独立短事务条件写 FAILED + TASK_FAILED；持久化失败仍可能降级，不能声称必成功。"
      ]
    },
    {
      "dot": "violet",
      "title": "两个线程 / 不同事实",
      "items": [
        "afterCommit 在请求线程调用有界 executor；HTTP 响应与 worker claim 无固定先后。",
        "claim 未取得就退出；成功提交 RUNNING 后才进入 Engine。201 不代表已执行；本图不展开执行循环。"
      ]
    }
  ]
