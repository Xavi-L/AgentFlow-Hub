      "from": "dc-permit",
      "to": "dc-observe",
      "label": "等待中止",
      "role": "error",
      "variant": "security"
    },
    {
      "id": "dc-exit",
      "from": "dc-body",
      "to": "dc-release",
      "label": "工作体退出",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "id": "dc-result",
      "from": "dc-release",
      "to": "dc-observe",
      "label": "未放弃：结果 / 异常",
      "role": "return",
      "variant": "dashed"
    }
  ],
