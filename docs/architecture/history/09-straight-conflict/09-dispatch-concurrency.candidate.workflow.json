      "to": "dc-claim",
      "label": "worker 领取",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "id": "dc-enter",
      "from": "dc-claim",
      "to": "dc-engine",
      "label": "claim 成功",
      "role": "main",
      "variant": "emphasis"
    },
    {
