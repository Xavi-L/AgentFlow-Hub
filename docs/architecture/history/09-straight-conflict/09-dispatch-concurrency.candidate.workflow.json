  "cards": [
    {
      "dot": "cyan",
      "title": "任务线程与排队容量",
      "items": [
        "core=2 → 优先入队100 → 队满扩至max=4 → AbortPolicy；零容量配置为直接交接。",
        "准入关闭也拒绝；claim/补偿使用短事务，0行不执行或发事件。"
      ]
    },
    {
      "dot": "rose",
      "title": "实际工作许可 · 默认4",
      "items": [
        "LLM、串行RAG、工具共用；可配置1–64。等待许可占任务线程，同步嵌套不重复申请。",
        "超时/取消只放弃等待；已进入的工作仍占许可，直到真正退出。"
      ]
    },
    {
      "dot": "violet",
      "title": "两种结束不能混同",
      "items": [
        "waiter 每≤50ms查边界；未进入body的取消由CAS归还，进入后仅body finally归还。",
        "迟到结果不推进业务；Runner后续结算。任务线程返回或Future取消均不证明provider已停。"
      ]
    }
  ]
}
