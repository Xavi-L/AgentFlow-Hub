  "cards": [
    {
      "dot": "cyan",
      "title": "Ingestion · 独立触发",
      "items": [
        "上传只保存文件；另行 process-pending，再 vectorize-pending。",
        "原文留在 PostgreSQL；Qdrant 存向量与定位元数据，remote 模式对应真实 adapter。"
      ]
    },
    {
      "dot": "rose",
      "title": "READY · 数据库派生",
      "items": [
        "KB ACTIVE、parse 完成、配置/策略兼容；当前代非空且全部向量化完成。",
        "上传、parse COMPLETED 均不足；READY 不证明 Qdrant 在线或点完整。"
      ]
    },
    {
      "dot": "emerald",
      "title": "Retrieval · 核验后消费",
      "items": [
        "冻结 generation；候选必须回查 PG 正文并核对 owner、vectorId 与 hash，不回落到新代。",
        "证据与引用进 decision / final；Trace 留快照，最终引用仍须白名单校验。"
      ]
    }
  ]
