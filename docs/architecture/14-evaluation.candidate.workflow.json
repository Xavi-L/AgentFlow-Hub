  "cards": [
    {
      "dot": "cyan",
      "title": "配置、Task、运行是三种身份",
      "items": [
        "配置：版本 ID / configHash；Task：taskId / 实际快照 / 有效哈希。",
        "运行：runId / manifestHash / case + trial / 原请求 key；计划先于 POST。"
      ]
    },
    {
      "dot": "orange",
      "title": "恢复有界，缺失不冒充通过",
      "items": [
        "未知提交复用原请求与 key，追加核对最多3次；已关联只观察，不重跑。",
        "judge 追加人工判定；缺评仍未评，失败、拒绝与未执行项保留分母。"
      ]
    },
    {
      "dot": "emerald",
      "title": "只读分析不等于质量提升",
      "items": [
        "report / compare / Episode 不新增模型或工具调用；比较缺条件则 NOT_COMPARABLE。",
        "既有真实12例已终态；人工评分覆盖0/11，B15未完成。无 Evaluation UI / DB 平台。"
