      "sublabel": "本地有界 executor",
      "width": 150,
      "height": 68
    },
    {
      "id": "wf-claim",
      "lane": "wf-worker",
      "col": 2,
      "type": "security",
      "label": "条件 claim",
      "sublabel": "RUNNING · TASK_STARTED",
      "width": 150,
      "height": 68
    },
    {
      "id": "wf-rag",
      "lane": "wf-worker",
      "col": 3,
      "type": "backend",
      "label": "前置冻结 RAG",
      "sublabel": "remote HTTP → canonical",
      "width": 150,
      "height": 68
    },
    {
      "id": "wf-decision",
      "lane": "wf-worker",
      "col": 4,
      "type": "backend",
      "label": "决策 / 预算门禁",
      "sublabel": "DECISION · Chat HTTP",
      "width": 150,
      "height": 68
    },
    {
      "id": "wf-final",
      "lane": "wf-worker",
      "col": 5,
      "type": "backend",
      "label": "独立最终生成",
      "sublabel": "Chat HTTP · 引用校验",
      "width": 150,
      "height": 68
    },
    {
      "id": "wf-tool",
      "lane": "wf-services",
      "col": 4,
      "type": "backend",
