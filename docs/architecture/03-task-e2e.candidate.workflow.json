  "meta": {
    "title": "03 · End-to-End Task Workflow — AgentFlow Hub",
    "locale": "zh-CN",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "wf-browser",
      "label": "Browser / 提交与只读观察"
    },
    {
      "id": "wf-services",
      "label": "JVM / 领域服务与短事务"
    },
    {
      "id": "wf-worker",
      "label": "JVM / 异步任务编排"
    }
  ],
  "nodes": [
    {
      "id": "wf-submit",
      "lane": "wf-browser",
      "col": 0,
      "type": "frontend",
      "label": "提交任务",
      "sublabel": "Bearer · 幂等 key",
      "width": 150,
      "height": 68
    },
    {
      "id": "wf-gate",
      "lane": "wf-services",
      "col": 0,
      "type": "security",
      "label": "认证 / 幂等门禁",
      "sublabel": "owner · admission · 查重",
      "width": 150,
      "height": 68
    },
    {
      "id": "wf-persist",
      "lane": "wf-services",
      "col": 1,
      "type": "database",
      "label": "快照与任务创建",
      "sublabel": "短事务 · QUEUED",
      "width": 150,
      "height": 68
    },
    {
      "id": "wf-dispatch",
      "lane": "wf-worker",
      "col": 1,
