  "cards": [
    {
      "dot": "cyan",
      "title": "连接与执行解耦",
      "items": [
        "断线 ≠ 取消；重连 ≠ 重启；刷新 ≠ 重执行。",
        "取消仅来自显式 POST cancel；观察链路不调用 Runner。"
      ]
    },
    {
      "dot": "orange",
      "title": "已处理游标是恢复基点",
      "items": [
        "事件写库后由 SSE 分页轮询；成功应用才推进游标。",
        "重试有预算；重复忽略，缺口 / 协议错误停止，禁止跳号。"
      ]
    },
    {
      "dot": "emerald",
      "title": "最终答案有一致性门槛",
      "items": [
        "终态后 GET Task + Trace 核对状态、watermark、答案和引用。",
        "Trace 页面仅查询；本图为代码 / 测试断言证据，非实机验收。"
      ]
    }
